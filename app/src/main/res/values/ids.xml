<?xml version="1.0" encoding="utf-8"?>
<resources>
    <item name="tag_bg_color" type="id" />
    <item name="tag_dirty" type="id" />

    <!-- Stable IDs for the Anki review editor's programmatic Original /
         Translation EditTexts (SentenceAnkiContentFragment). Android's
         view-hierarchy save/restore is keyed by view ID, so giving these
         fixed IDs lets TextView.SavedState round-trip the user's typed
         text across process death. -->
    <item name="etAnkiOriginal" type="id" />
    <item name="etAnkiTranslation" type="id" />

    <!-- The results section headers' action views. SectionHeaderRow builds
         them in code from TranslationSectionBinder's HeaderActions, so their
         ids live here rather than in section_source.xml / section_target.xml;
         tests and lookups find them as they found the old XML buttons. -->
    <item name="btnToggleFurigana" type="id" />
    <item name="btnSpeakOriginal" type="id" />
    <item name="btnEditOriginal" type="id" />
    <item name="btnAnkiOriginal" type="id" />
    <item name="btnToggleOriginal" type="id" />
    <item name="btnMoreOriginal" type="id" />
    <item name="btnShowOnScreen" type="id" />
    <item name="btnAnkiTranslation" type="id" />
    <item name="btnFontSize" type="id" />
    <item name="btnToggleTranslation" type="id" />
    <item name="btnMoreTranslation" type="id" />
    <!-- Show on screen and Text size in the Original header, where they sit
         while the Translation section is hidden. -->
    <item name="btnShowOnScreenOriginal" type="id" />
    <item name="btnFontSizeOriginal" type="id" />
    <!-- The Words header's eye and its (never shown) ⋯, built the same way
         from WordRowsBinder's HeaderAction. -->
    <item name="btnToggleWords" type="id" />
    <item name="btnMoreWords" type="id" />
    <!-- The Ask section's header and card. ResultSectionsLayout arranges the
         sections by id, on surfaces with and without an Ask section, so the
         two ids exist apart from section_ask.xml. -->
    <item name="askHeaderRow" type="id" />
    <item name="cardAsk" type="id" />
    <!-- The Ask header's eye and its (never shown) ⋯, built from
         AskSectionBinder's HeaderActions like the other headers'. The
         header's ready-made questions get generated ids: they are a list. -->
    <item name="btnToggleAsk" type="id" />
    <item name="btnMoreAsk" type="id" />
    <!-- The Ask header's Text size, offered while a question is on screen:
         it opens the one-handle picker for the answer's text. -->
    <item name="btnFontSizeAsk" type="id" />
    <!-- The slider row of a text-size picker (SizePickerCard), so a test
         can find it inside the popover. -->
    <item name="sizePickerTrack" type="id" />
    <!-- An ActionOverflowMenu row's parts. -->
    <item name="overflowRowIcon" type="id" />
    <item name="overflowRowLabel" type="id" />
</resources>
