<?xml version="1.0" encoding="utf-8"?>
<!-- Words section: header + card, the per-word list of the sentence. Shared by
     every surface that shows the results sections. merge-rooted like
     section_source.xml / section_target.xml, so the header and the card become
     direct children of the sections' parent. WordRowsBinder owns both. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <!-- The header: the section's name (with the row count once the rows are
         built), then the pinned eye, which SectionHeaderRow builds from
         WordRowsBinder's HeaderAction. The same row, paddings and height as the
         source and target headers. -->
    <com.playtranslate.ui.SectionHeaderRow
        android:id="@+id/wordsHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/pt_group_gap"
        android:paddingBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/labelWords"
            style="@style/Text.PT.GroupHeader"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/section_words" />

    </com.playtranslate.ui.SectionHeaderRow>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/ptCard"
        app:cardCornerRadius="@dimen/pt_radius"
        app:cardElevation="0dp"
        app:strokeColor="?attr/ptDivider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/wordsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMainWordsLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/pt_row_h_padding"
                android:paddingVertical="@dimen/pt_row_v_padding"
                android:text="@string/words_loading"
                android:textColor="?attr/ptTextHint"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/mainWordsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvNoWords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/pt_row_h_padding"
                android:paddingVertical="@dimen/pt_row_v_padding"
                android:text="@string/words_none"
                android:textColor="?attr/ptTextHint"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</merge>
